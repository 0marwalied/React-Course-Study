{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "lib": [
      "ES5",
      "ES2015.Promise"
    ],
    "module": "commonjs",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "target": "esnext",
    "typeRoots": [
      "../"
    ],
    "types": []
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
